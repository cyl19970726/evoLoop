  "lanes": [
    {
      "id": "intent",
      "label": "需求输入 · 人的方向与业务问题"
    },
    {
      "id": "lead",
      "label": "系统职责一 · Leader 任务管理"
    },
    {
      "id": "execution",
      "label": "业务 Session · 实际执行"
    },
    {
      "id": "acceptance",
      "label": "独立验收 · 默认 Agent，指定才由人"
    }
  ],
  "nodes": [
    {
      "id": "source",
      "lane": "intent",
      "col": 0,
      "type": "external",
      "label": "人／定时发现问题",
      "sublabel": "用户想法与业务反馈"
    },
    {
      "id": "intake",
      "lane": "intent",
      "col": 1,
      "type": "backend",
      "label": "需求澄清与转化",
      "sublabel": "Human Requirement 可按需承接"
    },
    {
      "id": "pool",
      "lane": "intent",
      "col": 2,
      "type": "database",
      "label": "Task 与 Document",

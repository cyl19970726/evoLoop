    },
    {
      "id": "dispatch",
      "lane": "lead",
      "col": 3,
      "type": "messagebus",
      "label": "任务引擎派发",
      "sublabel": "按顺序交原 Session"
    },
    {
      "id": "sync",
      "lane": "lead",
      "col": 5,
      "type": "backend",

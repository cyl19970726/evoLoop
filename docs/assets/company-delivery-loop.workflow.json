  "cards": [
    {
      "dot": "cyan",
      "title": "三种系统职责各有重心",
      "items": [
        "Leader管任务推进；Evocation看工作方式并推动自我提升；Human Requirement按需与你聊方向和需求。",
        "User Session是独立体验／评价职责，与Evocation配合；不额外设第四个统筹中心。",
        "逻辑分工已在本轮明确，实际常驻会话与自动化尚待配置和验证。"
      ]
    },
    {
      "dot": "emerald",
      "title": "授权与验收是两件事",
      "items": [
        "授权范围内，Agent可自行建任务、排期和执行；不是每个Task都先等人审批。",
        "任务明确验收人和方式；只有指定human review的那一项等待用户。"
      ]
    },
    {
      "dot": "amber",
      "title": "写回与同步的落地缺口",
      "items": [
        "执行者先提交有来源的阶段结果；运行真正结束后才能形成可验收交付。",
        "当前Run结束≠Task完成。Lead先周期对账，通知只是加速；漏通知也可从台账恢复。"
      ]
    },
    {
      "dot": "violet",
      "title": "时间只负责触发检查",
      "items": [
        "日程可触发需求挖掘、架构巡检或Lead对账；不要求每次都制造新任务。",
        "用户每日看的应是简明BP、关键图、取舍和结果；细节按需下钻。"
      ]
    },
    {
      "dot": "violet",
      "title": "日常工作与每日复盘相互连接",
      "items": [
        "业务任务按自己的验收要求推进，不默认等待一次晨会或Evocation审计。",
        "User Session可按指定消费者职责承接部分验收；其代理体验不能冒充真人满意。",
        "Leader提供真实进度与阻塞，Evocation汇合内部证据和独立体验，形成每日BP。"
      ]
    }
  ]
}

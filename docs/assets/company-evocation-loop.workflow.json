      "label": "内部轨迹和结果",
      "role": "branch"
    },
    {
      "id": "s2",
      "from": "user",
      "to": "observe",
      "label": "体验证据与卡点",
      "role": "main"
    },
    {
      "id": "s3",
      "from": "observe",
      "to": "diagnose",
      "label": "找可改原因",
      "role": "main"
    },
    {
      "id": "s4",
      "from": "diagnose",
      "to": "improvement",
      "label": "比较替代办法",
      "role": "main"
    },
    {
      "id": "s5",
      "from": "improvement",
      "to": "trial",
      "label": "与Leader共享任务与排期",
      "role": "main"
    },
    {
      "id": "s6",
      "from": "trial",
      "to": "check",
      "label": "实际消费与复测",
      "role": "main"
    },
    {
      "id": "s7",
      "from": "check",
      "to": "adopt",
      "label": "效果决定去留",
      "role": "main"
    },
    {
      "id": "s8",
      "from": "adopt",
      "to": "observe",
      "label": "带新结果进入下轮",
      "role": "return"
    }
  ],
  "cards": [
    {
      "dot": "cyan",
      "title": "一对互补的观察者",
      "items": [
        "User Session先按公开用户目标真实操作、对话和消费成果，保留原始困惑与证据。",
        "Evocation再结合Leader和业务Session trace解释原因；不先把审计答案教给体验者。",
        "两者分工互补，User Session不只是读trace后给一段评价。"
      ]
    },
    {
      "dot": "violet",
      "title": "复盘至少覆盖这些问题",
      "items": [
        "横向：Leader和其他Session如何交接，哪里反复传话、遗漏或等待。",
        "纵向：单个角色怎样工作，哪些方法可提炼为skill，哪些错误的机制需要修。",
        "端到端：用户能否使用产品、理解成果并完成目标；项目本身的新需求也进入Task。"
      ]
    },
    {
      "dot": "emerald",
      "title": "Evocation可以推动改变",
      "items": [
        "在授权内可形成改进Task、提炼和试用项目skill、准备或调整Session。",
        "日常依赖与任务顺序和Leader共享，不另建一套相互冲突的任务表。",
        "不是每次事故都加规则，也不是每次改进都增加常驻Session；按真实收益保留或撤回。"
      ]
    },
    {
      "dot": "amber",
      "title": "每天约一小时看懂全局",
      "items": [
        "Leader贡献业务进度；User Session贡献亲用结果；Evocation汇总问题、根因、改进和经验。",
        "BP先给大图和重点取舍，再下钻证据；一小时是讨论预算，不是全天工作的审批闸。",
        "Human Requirement可在晨间或单独对话中澄清方向，结论回到intent、Document与Task。"
      ]
    }
  ],
  "mainPath": [
    "user",
    "observe",
    "diagnose",
    "improvement",
    "trial",
    "check",
    "adopt"
  ]
}

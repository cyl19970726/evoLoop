    },
    {
      "id": "change",
      "label": "把发现转成方法与组织调整"
    },
    {
      "id": "evaluate",
      "label": "User Session 复测 · Evocation 据结果采纳"
    }
  ],
  "nodes": [
    {
      "id": "intent",
      "lane": "evidence",
      "col": 3,
      "type": "external",
      "label": "用户方向与intent",
      "sublabel": "Human Requirement 按需澄清"
    },
    {
      "id": "outcome",
      "lane": "evidence",
      "col": 1,
      "type": "database",
      "label": "Leader与业务事实",
      "sublabel": "trace、交付、返工与成本"
    },
    {
      "id": "user",
      "lane": "evidence",
      "col": 2,
      "type": "backend",
      "label": "User Session 亲自体验",
      "sublabel": "产品、交接、对话与成果"
    },
    {
      "id": "observe",
      "lane": "system",
      "col": 2,
      "type": "backend",
      "label": "Evocation 联合复盘",
      "sublabel": "汇合内外证据与每日BP"
    },
    {
      "id": "diagnose",
      "lane": "system",
      "col": 3,
